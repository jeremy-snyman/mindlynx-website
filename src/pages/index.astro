---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '../styles/global.css';
import CookieNotice from '../components/CookieNotice.astro';
import Companion from '../components/Companion.astro';

const title = 'MindLynx · Intelligence that gives something back';
const description =
  'MindLynx builds intelligence that gives people more ownership of their time, knowledge and future.';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07110f" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://mindlynx.ai/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MindLynx" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://mindlynx.ai/" />
    <meta property="og:image" content="https://mindlynx.ai/images/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Two kayakers paddling through a sunlit forest gorge" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://mindlynx.ai/images/og.jpg" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': 'https://mindlynx.ai/#organization',
            name: 'MindLynx',
            legalName: 'MindLynx Ltd',
            url: 'https://mindlynx.ai/',
            logo: 'https://mindlynx.ai/favicon.png',
            email: 'hello@mindlynx.ai',
            slogan: 'Intelligence that gives something back',
            description:
              'British AI studio building Helix, an operating system for work where AI agents and humans work side by side, and Albion, a family of open-source sovereign models.',
            identifier: {
              '@type': 'PropertyValue',
              propertyID: 'Companies House registration number',
              value: '17226845',
            },
            address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'GB' },
            sameAs: ['https://helix.work', 'https://albion.helix.work', 'https://github.com/mindlynx-ai'],
          },
          {
            '@type': 'WebSite',
            '@id': 'https://mindlynx.ai/#website',
            url: 'https://mindlynx.ai/',
            name: 'MindLynx',
            publisher: { '@id': 'https://mindlynx.ai/#organization' },
            inLanguage: 'en-GB',
          },
        ],
      })}
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline src="/tachyon-emit.js" defer></script>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="MindLynx home">
        <img class="brand-mark" src="/images/brand-mark.png" alt="" width="31" height="31" />
        MindLynx
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span>
        <span class="sr-only">Menu</span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Site">
        <a href="#why" data-track="nav-why">Why we build</a>
        <a href="#beliefs" data-track="nav-believe">What we believe</a>
        <a href="#what" data-track="nav-what">What we do</a>
        <a class="nav-cta" href="#talk" data-track="nav-talk">Talk to us</a>
      </nav>
    </header>

    <main id="top">
      <!-- Hero -->
      <section class="hero">
        <div class="hero-media" role="img" aria-label="Two kayakers paddling through a sunlit forest gorge on still water"></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="shell hero-content">
          <p class="eyebrow"><span>MindLynx · Building in Britain</span><span class="eyebrow-sep"> · </span><span>Building in the open</span></p>
          <h1>Reclaim your&nbsp;time.</h1>
          <p class="hero-copy">
            We build intelligence that gives people back their time, their space and creates
            real value.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#why" data-track="hero-why">Why we build <span aria-hidden="true">→</span></a>
            <a class="button button-quiet" href="#what" data-track="hero-what">See what we build</a>
          </div>
        </div>
        <a class="scroll-cue" href="#why">Discover <span class="scroll-line" aria-hidden="true"></span></a>
      </section>

      <!-- Statement -->
      <section class="section-light statement" id="why">
        <div class="shell statement-grid reveal">
          <p class="section-label">Why we build</p>
          <div>
            <h2>Technology should make life larger.</h2>
            <p class="lead">
              AI will change how people work. That should mean more opportunity, more ownership and
              more room for distinctly human judgement, not simply fewer people.
            </p>
            <p>
              MindLynx is a small studio in Britain. We start companies that put that principle to
              work, and we build them in the open.
            </p>
          </div>
        </div>
      </section>

      <!-- Beliefs -->
      <section class="beliefs" id="beliefs">
        <div class="shell">
          <div class="section-heading reveal">
            <p class="section-label">What we believe</p>
            <h2>The principles we build by.</h2>
          </div>
          <div class="belief-list">
            <article class="belief reveal">
              <p class="belief-number">01</p>
              <div>
                <h3>Time belongs to people</h3>
                <p>Technology should remove repetition without removing purpose.</p>
              </div>
            </article>
            <article class="belief reveal">
              <p class="belief-number">02</p>
              <div>
                <h3>Knowledge has value</h3>
                <p>
                  The people who understand the work should help shape the intelligence, and share
                  in what it creates.
                </p>
              </div>
            </article>
            <article class="belief reveal">
              <p class="belief-number">03</p>
              <div>
                <h3>The future should be broadly owned</h3>
                <p>
                  The advantages of AI should be available to one person starting out as readily as
                  to the world's largest organisations.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- Interlude -->
      <section class="interlude">
        <div class="interlude-image" role="img" aria-label="A person writing in a notebook beside a calm sea at dusk"></div>
        <div class="interlude-shade" aria-hidden="true"></div>
        <div class="shell interlude-strap reveal">
          <p class="section-label">MindLynx</p>
          <p>Intelligence that gives something back.</p>
        </div>
      </section>

      <!-- What we do -->
      <section class="section-light what" id="what">
        <div class="shell">
          <div class="section-heading reveal">
            <p class="section-label">What we do</p>
            <h2>How we give it back.</h2>
          </div>
          <p class="what-lead reveal">Time, space and money, returned. These are the offerings doing it.</p>

          <div class="product-list">
            <article class="product reveal">
              <p class="product-number"><span>01</span>Platform</p>
              <div>
                <h3>Helix</h3>
                <p class="product-promise">An operating system for work that simply gets done.</p>
                <p class="product-copy">
                  Built for AI agents and humans working side by side. Work moves safely and
                  autonomously, governed from the first action, so people spend their judgement
                  where it matters.
                </p>
                <p class="product-tags">For agents and humans · Safe autonomy · Governed by default</p>
                <a class="company-link" href="https://helix.work" target="_blank" rel="noopener noreferrer" data-track="helix-site">helix.work <span aria-hidden="true">→</span></a>
              </div>
            </article>

            <article class="product reveal">
              <p class="product-number"><span>02</span>Models · open source</p>
              <div>
                <h3>Albion</h3>
                <p class="product-promise">Intelligence that answers to no one else.</p>
                <p class="product-copy">
                  A family of open-source models that keep reasoning sovereign: independent of the
                  frontier labs, at a fraction of the cost. Taught by the people who know the work.
                </p>
                <p class="product-tags">Open source · Sovereign by design · Radically lower cost</p>
                <div class="product-links">
                  <a class="company-link" href="https://albion.helix.work" target="_blank" rel="noopener noreferrer" data-track="albion-site">albion.helix.work <span aria-hidden="true">→</span></a>
                  <a class="company-link" href="#talk" data-interest="albion" data-track="albion-waitlist">Join the waitlist <span aria-hidden="true">→</span></a>
                </div>
              </div>
            </article>

            <article class="product reveal">
              <p class="product-number"><span>03</span>Services · payment on results</p>
              <div>
                <h3>Strategic Consulting</h3>
                <p class="product-promise">One painful process, made to run itself.</p>
                <p class="product-copy">
                  We start by understanding the business and agree in writing what success looks
                  like, then tie the delivery to that. About four weeks later the process runs
                  itself, with receipts for what ran, why and what it cost, on your data, in your
                  estate. Fixed price, charged on outcome: half on signature, the balance when the
                  agreed result is running. We take a small number of these at a time.
                </p>
                <p class="product-tags">Outcomes rather than output · Fixed price on outcome · Data, operations, finance, compliance</p>
                <a class="company-link" href="#talk" data-interest="call" data-track="consulting-call">Set up a scoping call <span aria-hidden="true">→</span></a>
              </div>
            </article>
          </div>

          <div class="coming reveal">
            <p class="section-label">Coming next</p>
            <div class="coming-grid">
              <article class="coming-item">
                <h3>MindLynx Open Source</h3>
                <p>
                  The tools we prove, released for everyone to build on. What we run in
                  production (agents, scaffolding, evaluations), published as we go.
                </p>
              </article>
              <article class="coming-item">
                <h3>Cortex</h3>
                <p>
                  Memory that remains yours. A different answer to who holds what you know.
                  Announcement to follow.
                </p>
              </article>
              <article class="coming-item">
                <h3>Founders Accelerator</h3>
                <p>
                  Start, test and take products to market at a fraction of the usual cost,
                  working alongside our teams with Helix and Albion behind you.
                </p>
              </article>
            </div>
          </div>

          <div class="partner-card reveal">
            <div>
              <p class="section-label">Partner with us</p>
              <h3 class="partner-heading">Have a product in mind?</h3>
            </div>
            <div>
              <p class="partner-copy">
                Some of our clients are becoming founders of their own products, with MindLynx
                as a partner in the business. If you have an idea worth taking to market, we
                would like to hear it.
              </p>
              <a class="partner-link" href="#talk" data-interest="partner" data-track="partner-start">Start the conversation <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>

      <!-- Building in the open -->
      <section class="open-build">
        <div class="shell open-build-grid reveal">
          <p class="section-label">Building in the open</p>
          <div>
            <p class="lead">
              We are building this now. We release it piece by piece, publish what we prove and say
              clearly what remains unfinished.
            </p>
            <p>If you want to watch it happen, or tell us where we're wrong, we'd like that.</p>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section class="contact" id="talk">
        <div class="shell contact-grid">
          <div class="reveal">
            <p class="section-label">Talk to us</p>
            <a class="contact-mail" href="mailto:hello@mindlynx.ai" data-track="contact-mail">hello@mindlynx.ai</a>
          </div>
          <div class="reveal">
            <h2>The future should belong to more people.</h2>
            <p class="contact-lead">
              Whether you want to work with Helix, join the Albion waitlist, partner on a product
              or simply tell us what you think, write to us. A person reads every message.
            </p>

            <form class="contact-form" id="contact-form" novalidate>
              <div class="field">
                <label for="name">Name <span class="field-hint">(required)</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" />
              </div>
              <div class="field">
                <label for="email">Email <span class="field-hint">(required)</span></label>
                <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
              </div>
              <div class="field field-select">
                <label for="interest">I'm writing about</label>
                <select id="interest" name="interest">
                  <option value="general">A general enquiry</option>
                  <option value="call">A scoping call</option>
                  <option value="helix">The Helix waitlist</option>
                  <option value="albion">The Albion waitlist</option>
                  <option value="partner">Partnering on a product</option>
                </select>
              </div>
              <div class="field">
                <label for="message">Message <span class="field-hint">(optional)</span></label>
                <textarea id="message" name="message" maxlength="5000" placeholder="We do read everything."></textarea>
              </div>
              <div class="field consent-field" hidden>
                <label class="consent-label">
                  <input id="consent" name="consent" type="checkbox" value="yes" />
                  <span>
                    Email me news and launch updates for this list. I can unsubscribe at any time.
                  </span>
                </label>
              </div>
              <div class="hp" aria-hidden="true">
                <label for="company">Company</label>
                <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <div class="form-footer">
                <button class="button button-primary" type="submit" data-track="form-submit">Send message</button>
                <p class="form-status" role="status"></p>
              </div>
              <p class="form-note">
                We use your details to reply. The Albion list is opt-in via the box above and you
                can leave it at any time. Nothing else, no sharing. <a href="/privacy">Privacy</a>.
              </p>
            </form>

            <div class="form-success" hidden>
              <p>Thank you. We'll be in touch.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <span>MindLynx Ltd · Company No. 17226845 · London</span>
        <span><a href="/privacy" data-track="footer-privacy">Privacy</a> · Building in Britain · Building in the open</span>
      </div>
    </footer>

    <CookieNotice />
    <Companion />

    <script>
      const header = document.querySelector('.site-header')!;
      const setScrolled = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
      addEventListener('scroll', setScrolled, { passive: true });
      setScrolled();

      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
      toggle.addEventListener('click', () => {
        const open = document.body.classList.toggle('menu-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll('.site-nav a').forEach((a) =>
        a.addEventListener('click', () => {
          document.body.classList.remove('menu-open');
          toggle.setAttribute('aria-expanded', 'false');
        })
      );
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && document.body.classList.contains('menu-open')) {
          document.body.classList.remove('menu-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      const interestSelect = document.querySelector<HTMLSelectElement>('#interest')!;
      const consentField = document.querySelector<HTMLElement>('.consent-field')!;
      const consentBox = document.querySelector<HTMLInputElement>('#consent')!;
      const syncConsent = () => {
        consentField.hidden = !['albion', 'helix'].includes(interestSelect.value);
        if (consentField.hidden) consentBox.checked = false;
      };
      interestSelect.addEventListener('change', syncConsent);
      document.querySelectorAll<HTMLAnchorElement>('[data-interest]').forEach((a) =>
        a.addEventListener('click', () => {
          interestSelect.value = a.dataset.interest!;
          syncConsent();
        })
      );

      const form = document.querySelector<HTMLFormElement>('#contact-form')!;
      const status = form.querySelector<HTMLElement>('.form-status')!;
      const success = document.querySelector<HTMLElement>('.form-success')!;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.classList.remove('is-error');
        if (!form.reportValidity()) return;
        if (['albion', 'helix'].includes(interestSelect.value) && !consentBox.checked) {
          status.textContent = 'The waitlist is an email list, so please tick the box to join it.';
          status.classList.add('is-error');
          consentBox.focus();
          return;
        }
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        status.textContent = 'Sending…';
        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...Object.fromEntries(new FormData(form)),
              consentedAt: consentBox.checked ? new Date().toISOString() : '',
              pageUrl: location.href,
            }),
          });
          if (!res.ok) throw new Error(String(res.status));
          form.hidden = true;
          success.hidden = false;
          try {
            (window as any).Tachyon?.emit('LeadCaptured', {
              formType: 'contact',
              interest: interestSelect.value,
              marketingOptIn: consentBox.checked,
            });
          } catch {}
        } catch {
          status.textContent = 'Something went wrong. Please email hello@mindlynx.ai instead.';
          status.classList.add('is-error');
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
