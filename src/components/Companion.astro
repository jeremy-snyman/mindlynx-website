---
// Vera, the MindLynx front of house. Floating launcher + chat panel, ported
// from the Helix site's inline companion (helix-website/public/index.html).
// The launcher stays hidden until GET /api/agent confirms a live brain.
---

<aside class="companion" id="companion">
  <button
    class="cmp-launcher"
    id="cmp-launcher"
    type="button"
    data-track="companion-open"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Ask Vera, the MindLynx companion"
    hidden
  >
    <span class="cmp-launcher-dot" aria-hidden="true"></span>
    <span class="cmp-launcher-word">Ask</span>
  </button>

  <section class="cmp-panel" id="cmp-panel" role="dialog" aria-modal="false" aria-label="Conversation with Vera" hidden>
    <header class="cmp-bar">
      <span class="cmp-id"><i aria-hidden="true"></i>Vera · MindLynx front of house</span>
      <div class="cmp-bar-tools">
        <button class="cmp-voice" id="cmp-voice" type="button" hidden>Voice: start</button>
        <button class="cmp-close" id="cmp-close" type="button" aria-label="Close the conversation">×</button>
      </div>
    </header>
    <div class="cmp-chat" id="cmp-chat" aria-live="polite" aria-label="Messages"></div>
    <div class="cmp-chips" id="cmp-chips">
      <button class="cmp-chip" type="button">What do you actually do?</button>
      <button class="cmp-chip" type="button">What is Helix?</button>
      <button class="cmp-chip" type="button">What is Albion?</button>
      <button class="cmp-chip" type="button">How does the consulting work?</button>
      <button class="cmp-chip" type="button">Set up a scoping call</button>
    </div>
    <div class="cmp-input">
      <button class="cmp-mic" id="cmp-mic" type="button" title="Speak to Vera" aria-label="Speak to Vera" hidden>●</button>
      <input id="cmp-q" type="text" placeholder="Ask about MindLynx…" autocomplete="off" />
      <button class="cmp-send" id="cmp-send" type="button">Send</button>
    </div>
    <p class="cmp-note">Replies are generated by Anthropic's Claude. Nothing is stored. <a href="/privacy">Privacy</a></p>
  </section>
</aside>

<style is:global>
  /* All companion styles are global (chat bubbles and forms are created by
     script, so Astro's scoped selectors would never match them) and live
     under the .companion / .cmp- namespace. */
  .companion { --cmp-surface: rgba(7, 17, 15, 0.96); }

  .cmp-launcher {
    position: fixed;
    z-index: 50;
    right: 24px;
    bottom: 24px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: var(--cmp-surface);
    backdrop-filter: blur(14px);
    border: 1px solid var(--warm);
    color: var(--cream);
    cursor: pointer;
    font-family: var(--sans);
    transition: transform 200ms ease, background 200ms ease, bottom 200ms ease;
  }
  .cmp-launcher:hover { transform: translateY(-2px); background: var(--ink-soft); }
  .cmp-launcher[hidden] { display: none; }
  .cmp-launcher-word {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .cmp-launcher-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--warm); }
  .companion.open .cmp-launcher { display: none; }

  .cmp-panel {
    position: fixed;
    z-index: 55;
    right: 24px;
    bottom: 24px;
    width: min(420px, calc(100vw - 32px));
    height: min(680px, 85dvh);
    display: flex;
    flex-direction: column;
    background: var(--cmp-surface);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(247, 241, 229, 0.16);
    color: var(--cream);
  }
  .cmp-panel[hidden] { display: none; }

  .cmp-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line-light);
  }
  .cmp-id {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 241, 229, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .cmp-id i { width: 8px; height: 8px; border-radius: 50%; background: var(--warm); flex: none; }
  .cmp-bar-tools { flex: none; }
  .cmp-bar-tools { display: flex; align-items: center; gap: 6px; }
  .cmp-voice {
    white-space: nowrap;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--line-light);
    color: rgba(247, 241, 229, 0.75);
    padding: 7px 10px;
    cursor: pointer;
  }
  .cmp-voice:hover { border-color: var(--warm); color: var(--cream); }
  .cmp-close {
    background: none;
    border: 0;
    color: rgba(247, 241, 229, 0.75);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 6px 10px;
    margin: -6px -10px -6px 0;
  }
  .cmp-close:hover { color: var(--cream); }

  .cmp-chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--line-light) transparent;
  }
  .cmp-msg {
    max-width: 86%;
    padding: 11px 14px;
    font-size: 0.93rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }
  .cmp-msg.agent {
    background: rgba(247, 241, 229, 0.05);
    border: 1px solid var(--line-light);
    align-self: flex-start;
  }
  .cmp-msg.agent b { color: var(--warm); font-weight: 600; }
  .cmp-msg.agent a { color: var(--cream); text-decoration-color: var(--warm); text-underline-offset: 3px; }
  .cmp-msg.user { background: var(--warm); color: #10150f; align-self: flex-end; }

  .cmp-typing i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(247, 241, 229, 0.6);
    margin-right: 4px;
    animation: cmp-blink 1s infinite;
  }
  .cmp-typing i:nth-child(2) { animation-delay: 0.2s; }
  .cmp-typing i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes cmp-blink { 0%, 60%, 100% { opacity: 0.25; } 30% { opacity: 1; } }

  .cmp-chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 14px; }
  .cmp-chip {
    font-family: var(--sans);
    font-size: 0.78rem;
    border: 1px solid var(--line-light);
    color: rgba(247, 241, 229, 0.72);
    background: none;
    padding: 8px 12px;
    cursor: pointer;
  }
  .cmp-chip:hover { border-color: var(--warm); color: var(--cream); }

  .cmp-input { display: flex; border-top: 1px solid var(--line-light); }
  .cmp-mic {
    width: 52px;
    border: 0;
    border-right: 1px solid var(--line-light);
    background: none;
    color: rgba(247, 241, 229, 0.6);
    cursor: pointer;
    font-size: 1rem;
  }
  .cmp-mic:hover, .cmp-mic.live { color: var(--warm); }
  .cmp-mic.rec { color: #e26d5c; animation: cmp-recpulse 1.2s infinite; }
  @keyframes cmp-recpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  .cmp-input input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.95rem;
    padding: 15px 14px;
    outline: none;
  }
  .cmp-input input::placeholder { color: rgba(247, 241, 229, 0.45); }
  .cmp-send {
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--warm);
    color: #10150f;
    border: 0;
    padding: 0 22px;
    cursor: pointer;
    font-weight: 600;
  }

  .cmp-note {
    margin: 0;
    padding: 9px 18px 12px;
    font-size: 0.7rem;
    color: rgba(247, 241, 229, 0.5);
  }
  .cmp-note a { color: inherit; text-decoration-color: var(--warm); text-underline-offset: 2px; }

  /* In-chat action form, created by script inside an agent bubble. */
  .cmp-form { display: grid; gap: 9px; margin-top: 10px; min-width: 240px; }
  .cmp-form input[type='text'],
  .cmp-form input[type='email'] {
    width: 100%;
    background: rgba(9, 18, 15, 0.6);
    border: 1px solid var(--line-light);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.88rem;
    padding: 10px 12px;
    outline: none;
  }
  .cmp-form input:focus { border-color: var(--warm); }
  .cmp-form label.cmp-consent {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 0.8rem;
    color: rgba(247, 241, 229, 0.72);
    cursor: pointer;
  }
  .cmp-form label.cmp-consent input { accent-color: var(--warm); width: 15px; height: 15px; flex: none; margin-top: 2px; }
  .cmp-form label.cmp-consent a { color: var(--cream); }
  .cmp-form .cmp-go,
  .cmp-form .cmp-cal {
    font-family: var(--sans);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    background: var(--warm);
    color: #10150f;
    border: 0;
    padding: 11px 16px;
    cursor: pointer;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    display: block;
  }
  .cmp-form .cmp-cal { background: none; border: 1px solid var(--warm); color: var(--cream); }
  .cmp-form .cmp-go:disabled { opacity: 0.55; cursor: default; }
  .cmp-cal-wrap { display: grid; gap: 8px; }
  .cmp-cal-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .cmp-cal-day { font-size: 0.8rem; color: var(--warm); letter-spacing: 0.03em; }
  .cmp-cal-prev,
  .cmp-cal-next {
    width: 34px;
    height: 34px;
    border: 1px solid var(--line-light);
    background: none;
    color: rgba(247, 241, 229, 0.8);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }
  .cmp-cal-prev:hover:not(:disabled),
  .cmp-cal-next:hover:not(:disabled) { border-color: var(--warm); color: var(--cream); }
  .cmp-cal-prev:disabled,
  .cmp-cal-next:disabled { opacity: 0.35; cursor: default; }
  .cmp-slots { position: relative; display: flex; flex-wrap: wrap; gap: 6px; max-height: 140px; overflow-y: auto; }
  .cmp-slot {
    font-family: var(--sans);
    font-size: 0.76rem;
    border: 1px solid var(--line-light);
    color: rgba(247, 241, 229, 0.8);
    background: none;
    padding: 7px 10px;
    cursor: pointer;
  }
  .cmp-slot:hover { border-color: var(--warm); color: var(--cream); }
  .cmp-slot.sel { background: var(--warm); border-color: var(--warm); color: #10150f; }

  @media (max-width: 640px) {
    .cmp-panel { inset: 0; width: 100%; height: 100dvh; border: 0; }
    .cmp-launcher { right: 16px; bottom: 16px; }
    .cmp-chip { padding: 12px 14px; }
    .cmp-close { padding: 10px 14px; margin: -10px -14px -10px 0; }
    .cmp-voice { padding: 11px 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-launcher { transition: none; }
    .cmp-typing i, .cmp-mic.rec { animation: none; }
  }
</style>

<script>
  // Ported from helix-website/public/index.html (Ask Helix + voice pipeline).
  // Live model output is untrusted and only ever rendered with textContent;
  // innerHTML is reserved for author-written strings.
  const root = document.getElementById('companion')!;
  const launcher = document.getElementById('cmp-launcher') as HTMLButtonElement;
  const panel = document.getElementById('cmp-panel')!;
  const chat = document.getElementById('cmp-chat')!;
  const input = document.getElementById('cmp-q') as HTMLInputElement;
  const mic = document.getElementById('cmp-mic') as HTMLButtonElement;
  const voiceBtn = document.getElementById('cmp-voice') as HTMLButtonElement;

  const AGENT_ENDPOINT = '/api/agent';
  const FORM_ENDPOINT = '/api/contact';
  const LIVE = { agent: false, voice: false, calendly: '' };
  const history: { role: 'user' | 'agent'; content: string }[] = [];
  const lead = { name: '', email: '' };
  let opened = false;

  fetch(AGENT_ENDPOINT)
    .then((r) => r.json())
    .then((d) => {
      LIVE.agent = !!d.agent;
      LIVE.voice = !!d.voice;
      LIVE.calendly = typeof d.calendly === 'string' ? d.calendly : '';
      if (LIVE.agent) launcher.hidden = false;
      if (LIVE.voice) {
        mic.hidden = false;
        mic.classList.add('live');
        voiceBtn.hidden = false;
      }
    })
    .catch(() => {});

  /* ---- keep the launcher clear of the cookie notice ---- */
  const cookieNotice = document.querySelector<HTMLElement>('.cookie-notice');
  function dodgeCookieNotice() {
    if (cookieNotice && !cookieNotice.hidden && window.innerWidth < 880) {
      launcher.style.bottom = `${cookieNotice.offsetHeight + 36}px`;
    } else {
      launcher.style.bottom = '';
    }
  }
  if (cookieNotice) {
    new MutationObserver(dodgeCookieNotice).observe(cookieNotice, { attributes: true, attributeFilter: ['hidden'] });
    window.addEventListener('resize', dodgeCookieNotice, { passive: true });
    dodgeCookieNotice();
  }

  /* ---- open / close ---- */
  const smallScreen = () => window.matchMedia('(max-width: 640px)').matches;
  function openPanel() {
    root.classList.add('open');
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    if (smallScreen()) document.body.style.overflow = 'hidden';
    input.focus();
    if (!opened) {
      opened = true;
      agentSay(
        "Hello, I'm <b>Vera</b>. I can tell you about what we build here, and whether it's likely to be any use to you. What brought you along?"
      );
    }
  }
  function closePanel() {
    stopLive();
    root.classList.remove('open');
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    launcher.focus();
  }
  launcher.addEventListener('click', openPanel);
  document.getElementById('cmp-close')!.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closePanel();
  });

  /* ---- chat rendering ---- */
  function el(html: string, cls: string) {
    const d = document.createElement('div');
    d.className = 'cmp-msg ' + cls;
    d.innerHTML = html; // author-written strings only
    chat.appendChild(d);
    chat.scrollTop = chat.scrollHeight;
    return d;
  }
  function esc(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
  function agentSay(html: string) {
    const t = el('<span class="cmp-typing"><i></i><i></i><i></i></span>', 'agent');
    setTimeout(() => {
      t.innerHTML = html;
      chat.scrollTop = chat.scrollHeight;
    }, 450 + Math.random() * 350);
  }

  const OUTAGE_LINE =
    'I am having trouble reaching my brain just now. Give it another go in a moment, or use the contact form on this page, or email <a href="mailto:hello@mindlynx.ai">hello@mindlynx.ai</a>.';

  function ask(q: string) {
    if (!q.trim() || !LIVE.agent) return;
    el(esc(q), 'user');
    history.push({ role: 'user', content: q });
    const t = el('<span class="cmp-typing"><i></i><i></i><i></i></span>', 'agent');
    fetch(AGENT_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: q, history }),
    })
      .then((r) => {
        if (!r.ok) throw 0;
        return r.json();
      })
      .then((d) => {
        if (!d.reply) throw 0;
        t.textContent = d.reply; // live model output: never innerHTML
        chat.scrollTop = chat.scrollHeight;
        history.push({ role: 'agent', content: d.reply });
        if (d.action && d.action.type === 'show_action_form') {
          lead.name = d.action.name || '';
          lead.email = d.action.email || '';
          setTimeout(() => showActionForm(d.action.intent, d.action.topic || '', d.action.preferredTime || '', d.action.preferredDate || ''), 600);
        }
      })
      .catch(() => {
        t.innerHTML = OUTAGE_LINE;
        chat.scrollTop = chat.scrollHeight;
      });
    input.value = '';
  }

  document.getElementById('cmp-send')!.addEventListener('click', () => ask(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') ask(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>('#cmp-chips .cmp-chip').forEach((c) => {
    c.addEventListener('click', () => ask(c.textContent || ''));
  });

  /* ---- the action form: render-only, the human presses submit ---- */
  type IntentCopy = {
    title: string;
    go: string;
    interest: string;
    consent: boolean;
    consentLabel?: string;
    topicHint?: string;
    timeHint?: string;
    calendly?: boolean;
    messageLead: string;
    thanks: string;
  };
  const INTENT_COPY: Record<string, IntentCopy> = {
    helix_waitlist: {
      title: 'Your Helix waiting-list sign-up', go: 'Put me on the list', interest: 'helix', consent: true,
      messageLead: 'Helix waiting list, via Vera.', thanks: 'You will hear from us the moment there is news.',
    },
    albion_waitlist: {
      title: 'Your Albion waitlist sign-up', go: 'Put me on the list', interest: 'albion', consent: true,
      topicHint: 'Your sector (it shapes what gets built first)',
      messageLead: 'Albion waitlist, via Vera.', thanks: 'You will hear from us the moment there is news.',
    },
    albion_contributor: {
      title: 'Your contributor register entry', go: 'Add me to the register', interest: 'contributor', consent: true,
      consentLabel: 'Contact me when my sector opens, with the terms in plain English. I can unsubscribe at any time',
      topicHint: 'Your sector and expertise',
      messageLead: 'Albion contributor register, via Vera.', thanks: 'When your sector opens, the terms come to you in plain English.',
    },
    scoping_call: {
      title: 'Your scoping call', go: 'Request the call', interest: 'call', consent: false, calendly: true,
      topicHint: 'What should we look at?', timeHint: 'When would suit? (e.g. Thursday afternoon)',
      messageLead: 'Scoping call request, via Vera.', thanks: 'The team will reply by email with times for the call.',
    },
    design_partner: {
      title: 'Your design partner conversation', go: 'Start the conversation', interest: 'partner', consent: false,
      topicHint: 'What would you like to shape?',
      messageLead: 'Design partner conversation, via Vera.', thanks: 'The team will come back to you to set up the conversation.',
    },
    send_info: {
      title: 'Your details for the team', go: 'Send it to the team', interest: 'general', consent: false,
      topicHint: 'What is it about?',
      messageLead: 'Follow-up request, via Vera.', thanks: 'Someone will come back to you properly.',
    },
  };

  /* The in-form slot picker: a one-day view with prev/next day arrows. Days
     come from /api/availability in 7-day windows; browsing past the loaded
     window fetches the next one, and browsing back past the anchor loads from
     today. Nothing renders if the diary is unreachable. */
  function buildSlotPicker(
    bubble: HTMLElement,
    timeField: HTMLInputElement,
    go: HTMLButtonElement,
    preferredDate: string,
    preferredTime: string,
    onPick: (s: { start: string; label: string }) => void
  ) {
    const dayKey = (iso: string) =>
      new Date(iso).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/London' });
    const timeLabel = (iso: string) =>
      new Date(iso).toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Europe/London' });
    const slotMinutes = (iso: string) => {
      const [h, m] = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: 'numeric', hour12: false, timeZone: 'Europe/London' })
        .format(new Date(iso))
        .split(':');
      return parseInt(h, 10) * 60 + parseInt(m, 10);
    };
    /* The agreed time, as minutes-of-day, out of whatever wording the model
       passed ("2:00 pm", "Monday 3 August at 2pm", "14:30"). Null if none. */
    const wantedMinutes = (() => {
      const ampm = preferredTime.match(/(\d{1,2})(?:[:.](\d{2}))?\s*(am|pm)/i);
      if (ampm) {
        let h = parseInt(ampm[1], 10) % 12;
        if (ampm[3].toLowerCase() === 'pm') h += 12;
        return h * 60 + (ampm[2] ? parseInt(ampm[2], 10) : 0);
      }
      const h24 = preferredTime.match(/\b(\d{1,2})[:.](\d{2})\b/);
      if (h24) return parseInt(h24[1], 10) * 60 + parseInt(h24[2], 10);
      return null;
    })();

    const days: { key: string; slots: { start: string; label: string }[] }[] = [];
    let idx = 0;
    let fetching = false;
    let exhausted = false;
    let chosenStart = '';

    const wrap = document.createElement('div');
    wrap.className = 'cmp-cal-wrap';
    wrap.innerHTML =
      '<div class="cmp-cal-head">' +
      '<button type="button" class="cmp-cal-prev" aria-label="Earlier day">&#8249;</button>' +
      '<span class="cmp-cal-day"></span>' +
      '<button type="button" class="cmp-cal-next" aria-label="Later day">&#8250;</button>' +
      '</div><div class="cmp-slots"></div>';
    const dayTitle = wrap.querySelector<HTMLElement>('.cmp-cal-day')!;
    const slotsBox = wrap.querySelector<HTMLElement>('.cmp-slots')!;
    const prevBtn = wrap.querySelector<HTMLButtonElement>('.cmp-cal-prev')!;
    const nextBtn = wrap.querySelector<HTMLButtonElement>('.cmp-cal-next')!;

    const ingest = (list: { start: string; label: string }[]) => {
      list.forEach((s) => {
        const k = dayKey(s.start);
        let d = days.find((x) => x.key === k);
        if (!d) {
          d = { key: k, slots: [] };
          days.push(d);
        }
        if (!d.slots.some((x) => x.start === s.start)) d.slots.push(s);
      });
      days.forEach((d) => d.slots.sort((a, b) => a.start.localeCompare(b.start)));
      days.sort((a, b) => a.slots[0].start.localeCompare(b.slots[0].start));
    };
    const fetchWindow = (from: string) => {
      fetching = true;
      return fetch('/api/availability' + (from ? '?from=' + encodeURIComponent(from) : ''))
        .then((r) => (r.ok ? r.json() : null))
        .then((av) => {
          fetching = false;
          if (!av || !av.ok || !av.slots || !av.slots.length) return false;
          ingest(av.slots);
          return true;
        })
        .catch(() => {
          fetching = false;
          return false;
        });
    };
    const render = () => {
      const d = days[idx];
      if (!d) return;
      dayTitle.textContent = d.key;
      prevBtn.disabled = idx === 0 && new Date(d.slots[0].start).getTime() < Date.now() + 26 * 3600_000;
      nextBtn.disabled = exhausted && idx === days.length - 1;
      slotsBox.innerHTML = '';
      d.slots.forEach((s) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cmp-slot' + (s.start === chosenStart ? ' sel' : '');
        b.textContent = timeLabel(s.start);
        b.addEventListener('click', () => {
          select(s);
          render();
        });
        slotsBox.appendChild(b);
      });
      /* The chosen time stays in view, centred, even when the day has more
         slots than the box shows. Manual maths rather than scrollIntoView so
         the chat's own scroll position is never disturbed. */
      const sel = slotsBox.querySelector<HTMLElement>('.sel');
      if (sel) slotsBox.scrollTop = sel.offsetTop - slotsBox.clientHeight / 2 + sel.clientHeight / 2;
    };
    const select = (s: { start: string; label: string }) => {
      chosenStart = s.start;
      timeField.value = s.label;
      go.textContent = 'Book ' + s.label;
      onPick(s);
    };
    prevBtn.addEventListener('click', () => {
      if (idx > 0) {
        idx--;
        render();
      } else if (!fetching) {
        // Browsed back past the anchor: load from today and stay oriented.
        const current = days[idx]?.key;
        fetchWindow('').then((ok) => {
          if (!ok) return;
          const i = days.findIndex((d) => d.key === current);
          idx = Math.max(0, i - 1);
          render();
        });
      }
    });
    nextBtn.addEventListener('click', () => {
      if (idx < days.length - 1) {
        idx++;
        render();
      } else if (!fetching && !exhausted) {
        // Past the loaded window: pull the next seven days.
        const lastDay = days[days.length - 1];
        const lastStart = lastDay?.slots[lastDay.slots.length - 1]?.start;
        const from = lastStart
          ? new Date(new Date(lastStart).getTime() + 86_400_000).toISOString().slice(0, 10)
          : '';
        const current = days[idx]?.key;
        fetchWindow(from).then((ok) => {
          if (!ok) {
            exhausted = true;
            render();
            return;
          }
          const i = days.findIndex((d) => d.key === current);
          idx = Math.min(i + 1, days.length - 1);
          render();
        });
      }
    });

    fetchWindow(preferredDate || '').then((ok) => {
      if (!ok || !days.length) return;
      // Direct booking replaces the trip to Calendly.
      bubble.querySelector('.cmp-cal')?.remove();
      idx = 0;
      // A time was agreed in conversation: arrive with it already selected,
      // in view, and the button armed to book it.
      if (wantedMinutes !== null) {
        const match = days[idx].slots.find((s) => slotMinutes(s.start) === wantedMinutes);
        if (match) select(match);
      }
      timeField.insertAdjacentElement('afterend', wrap);
      render();
    });
  }

  let lastForm: HTMLElement | null = null;
  function showActionForm(intent: string, topic: string, preferredTime = '', preferredDate = '') {
    const copy = INTENT_COPY[intent] || INTENT_COPY.send_info;
    /* never pre-fill fabricated values: a placeholder-looking email renders blank */
    if (/example|placeholder|test@|@test\.|your.?email|@email\./i.test(lead.email)) lead.email = '';
    if (lastForm) {
      const oldGo = lastForm.querySelector<HTMLButtonElement>('.cmp-go');
      if (oldGo && !oldGo.disabled) {
        oldGo.disabled = true;
        oldGo.textContent = 'Replaced below';
      }
    }
    const calendly = copy.calendly && LIVE.calendly;
    let html = '<b>' + copy.title + '</b><div class="cmp-form">';
    html += '<input type="text" class="cmp-f-name" value="' + esc(lead.name) + '" placeholder="Name">';
    html += '<input type="email" class="cmp-f-email" value="' + esc(lead.email) + '" placeholder="Email">';
    if (copy.topicHint) {
      html += '<input type="text" class="cmp-f-topic" value="' + esc(topic) + '" placeholder="' + esc(copy.topicHint) + '">';
    }
    if (copy.timeHint) {
      html += '<input type="text" class="cmp-f-time" value="' + esc(preferredTime) + '" placeholder="' + esc(copy.timeHint) + '">';
    }
    if (copy.consent) {
      const label = copy.consentLabel || 'Email me news and launch updates for this list. I can unsubscribe at any time';
      html += '<label class="cmp-consent"><input type="checkbox" class="cmp-f-consent"> <span>' + label + ' (<a href="/privacy">privacy</a>).</span></label>';
    }
    if (calendly) {
      html += '<a class="cmp-cal" href="' + esc(LIVE.calendly) + '" target="_blank" rel="noopener noreferrer">Pick a time on the calendar</a>';
    }
    html += '<button class="cmp-go" type="button">' + copy.go + '</button></div>';
    const bubble = el(html, 'agent');
    lastForm = bubble;
    let chosenSlot: { start: string; label: string } | null = null;
    if (intent === 'scoping_call') {
      // A little calendar inside the form: one day at a time, arrows to move
      // between days, every slot of the day visible. Anchored on the day the
      // conversation agreed, but fully browsable, so a stale or wrong anchor
      // costs the visitor one arrow press instead of the right time.
      const timeField = bubble.querySelector<HTMLInputElement>('.cmp-f-time');
      const goBtn = bubble.querySelector<HTMLButtonElement>('.cmp-go');
      if (timeField && goBtn) {
        buildSlotPicker(bubble, timeField, goBtn, preferredDate, preferredTime, (s) => {
          chosenSlot = s;
        });
      }
    }
    bubble.querySelector<HTMLButtonElement>('.cmp-go')!.addEventListener('click', () => {
      const n = bubble.querySelector<HTMLInputElement>('.cmp-f-name')!.value.trim();
      const e = bubble.querySelector<HTMLInputElement>('.cmp-f-email')!.value.trim();
      const consentBox = bubble.querySelector<HTMLInputElement>('.cmp-f-consent');
      const topicField = bubble.querySelector<HTMLInputElement>('.cmp-f-topic');
      if (!n || !/.+@.+\..+/.test(e)) {
        agentSay('I still need a name and a real email on that form.');
        return;
      }
      if (copy.consent && !(consentBox && consentBox.checked)) {
        agentSay("It's an email list, so I need the consent box ticked before I can add you. The privacy notice is linked right there on the form.");
        return;
      }
      const topicText = topicField ? topicField.value.trim() : '';
      const timeField = bubble.querySelector<HTMLInputElement>('.cmp-f-time');
      const timeText = timeField ? timeField.value.trim() : '';
      const consented = !!(consentBox && consentBox.checked);
      const submitContact = (message: string, thanks: string) =>
        fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: n,
            email: e,
            interest: copy.interest,
            message,
            consent: consented ? 'yes' : '',
            consentedAt: consented ? new Date().toISOString() : '',
            pageUrl: location.href,
            source: 'mindlynx.ai/companion',
            company: '',
          }),
        }).then((r) => {
          if (!r.ok) throw 0;
          const go = bubble.querySelector<HTMLButtonElement>('.cmp-go')!;
          go.disabled = true;
          go.textContent = 'Done';
          (window as any).Tachyon?.emit('LeadCaptured', {
            formType: 'companion',
            interest: copy.interest,
            marketingOptIn: consented,
          });
          agentSay('<b>' + esc(n.split(' ')[0]) + ', ' + thanks + '</b>');
        });
      const baseMessage =
        copy.messageLead +
        (topicText ? ' About: ' + topicText + '.' : '') +
        (timeText ? ' Preferred time: ' + timeText + '.' : '');
      const submission = chosenSlot
        ? // The human picked a real slot: book it here, on this site, and let
          // the notification email carry the fact rather than a preference.
          fetch('/api/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ start: chosenSlot.start, name: n, email: e }),
          }).then((r) => {
            if (r.ok) {
              /* On a voice call, tell the service too: the tool call ended long
                 before the button press, so without this Vera never learns the
                 booking landed — she now confirms it out loud. */
              if (live.client) {
                try { live.client.sendClientMessage('booking_confirmed', { label: chosenSlot!.label }); } catch {}
              }
              return submitContact(
                copy.messageLead + (topicText ? ' About: ' + topicText + '.' : '') + ' BOOKED: ' + chosenSlot!.label + '.',
                "that's booked for " + esc(chosenSlot!.label) + '. The calendar invite is on its way to your inbox.'
              );
            }
            // Booking refused (slot just taken, or the diary is unreachable):
            // fall back to the request-by-email path so nothing is lost.
            chosenSlot = null;
            return submitContact(baseMessage, "that's with the team. " + copy.thanks);
          })
        : submitContact(baseMessage, "that's with the team. " + copy.thanks);
      submission
        .catch(() => {
          agentSay('That did not save. Give the button one more press, or use the contact form further down the page.');
        });
    });
  }

  /* ---- voice: the Helix Pipecat service (Deepgram STT -> Gemini -> Cartesia TTS) ---- */
  const vlog = (stage: string, detail?: unknown) => console.log('[voice]', stage, detail || '');

  /* The TTS pipeline can re-emit the tail of a segment, so a reply arrives with its
     last sentence duplicated. Only CONSECUTIVE duplicates go: a reply may
     legitimately repeat a sentence later on. (Ported from helix-ui.) */
  function collapseRepeatedSentences(text: string): string {
    const parts = text.match(/[^.!?]+[.!?]*\s*/g);
    if (!parts || parts.length < 2) return text;
    const kept: string[] = [];
    for (const part of parts) {
      const previous = kept[kept.length - 1];
      const same = previous !== undefined && previous.trim().toLowerCase() === part.trim().toLowerCase();
      if (same && part.trim().includes(' ')) continue;
      kept.push(part);
    }
    return kept.join('').trim();
  }

  /* One reply is several TTS utterances, so bot-stopped-speaking fires several times
     per answer; wait for real quiet before treating the turn as finished. */
  const TURN_SETTLE_MS = 1500;

  const live: any = { client: null, audioEl: null, timer: null, settle: null, connBub: null, userBub: null, botBub: null, botText: '' };

  function finaliseUser() {
    if (live.userBub) {
      const t = live.userBub.textContent || '';
      if (t) history.push({ role: 'user', content: t });
      live.userBub = null;
    }
  }
  function finaliseBot() {
    if (live.settle) { clearTimeout(live.settle); live.settle = null; }
    if (live.botBub) {
      const t = collapseRepeatedSentences(live.botText.trim());
      live.botBub.textContent = t;
      if (t) history.push({ role: 'agent', content: t });
      live.botBub = null;
      live.botText = '';
    }
  }

  function refreshVoiceUi() {
    voiceBtn.textContent = live.client ? 'Voice: live · stop' : 'Voice: start';
  }

  function stopLive(notice?: string) {
    if (live.timer) { clearTimeout(live.timer); live.timer = null; }
    if (live.connBub) { live.connBub.textContent = 'Voice did not connect this time.'; live.connBub = null; }
    finaliseUser();
    finaliseBot();
    if (live.client) { const c = live.client; live.client = null; try { c.disconnect(); } catch {} }
    // A left Daily call instance refuses the next join: reconnecting after the
    // five-minute cap failed until the instance is destroyed and made fresh.
    if (live.call) { const dc = live.call; live.call = null; setTimeout(() => { try { dc.destroy(); } catch {} }, 500); }
    if (live.audioEl) { try { live.audioEl.pause(); } catch {} live.audioEl = null; }
    mic.classList.remove('rec');
    refreshVoiceUi();
    if (notice) agentSay(notice);
  }

  async function startLive() {
    mic.classList.add('rec');
    voiceBtn.textContent = 'Voice: connecting…';
    live.connBub = el('<span class="cmp-typing"><i></i><i></i><i></i></span>&nbsp; Connecting you to Vera&hellip;', 'agent');
    vlog('start', { secure: window.isSecureContext });
    const r = await fetch('/api/voice-token', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    if (!r.ok) { vlog('mint-fail', { status: r.status }); throw new Error('mint ' + r.status); }
    const d = await r.json();
    vlog('mint-ok');
    const [cj, tj, dj] = await Promise.all([
      import('@pipecat-ai/client-js'),
      import('@pipecat-ai/small-webrtc-transport'),
      import('@daily-co/daily-js'),
    ]);
    vlog('sdk-ok');
    /* The transport's media manager reuses an existing Daily call instance. Creating it
       ourselves lets us pin useDevicePreferenceCookies:false at the one choke point every
       entry path reads its config from — otherwise Daily restores whichever microphone was
       used LAST (a nearby iPhone over Continuity, in the worst case) and the agent goes
       deaf with no visible error. (Ported from helix-ui, which hit exactly that.) */
    const Daily = dj.default;
    const call = Daily.getCallInstance() ?? Daily.createCallObject();
    live.call = call;
    const originalLoad = call.load.bind(call);
    (call as any).load = (props?: Record<string, unknown>) =>
      originalLoad({
        ...(props ?? {}),
        dailyConfig: { ...((props?.dailyConfig as object) ?? {}), useDevicePreferenceCookies: false },
      } as Parameters<typeof originalLoad>[0]);
    /* A television in the room is speech; strip it before the track leaves the browser. */
    void call.updateInputSettings({ audio: { processor: { type: 'noise-cancellation' } } }).catch(() => undefined);
    void call
      .setInputDevicesAsync({ audioDeviceId: 'default' })
      .then((devices: any) => vlog('mic', devices?.mic?.label ?? 'unknown'))
      .catch(() => undefined);

    const client = new cj.PipecatClient({
      transport: new tj.SmallWebRTCTransport(),
      enableMic: true,
      enableCam: false,
      callbacks: {
        onTrackStarted: (track: MediaStreamTrack) => {
          if (track.kind !== 'audio') return;
          if (!live.audioEl) {
            live.audioEl = document.createElement('audio');
            live.audioEl.autoplay = true;
          }
          live.audioEl.srcObject = new MediaStream([track]);
          void live.audioEl.play().catch(() => undefined);
          vlog('audio-attached');
        },
        onUserTranscript: (data: any) => {
          if (!data || !data.final || !data.text) return;
          /* You speaking again ends the previous turn, whatever the agent was doing. */
          if (live.botBub) finaliseBot();
          if (!live.userBub) live.userBub = el('', 'user');
          live.userBub.textContent = (live.userBub.textContent ? live.userBub.textContent + ' ' : '') + data.text.trim();
          chat.scrollTop = chat.scrollHeight;
        },
        onBotTtsText: (data: any) => {
          if (!data || !data.text) return;
          if (!live.botBub) {
            finaliseUser();
            live.botBub = el('', 'agent');
            live.botText = '';
          }
          /* House style: no em dashes reach the transcript, whatever was spoken. */
          live.botText += (live.botText ? ' ' : '') + data.text.replace(/\s*—\s*/g, ', ');
          live.botBub.textContent = collapseRepeatedSentences(live.botText);
          chat.scrollTop = chat.scrollHeight;
        },
        onBotStoppedSpeaking: () => {
          /* NOT the end of the turn: each streamed sentence ends here. Wait for real quiet. */
          if (live.settle) clearTimeout(live.settle);
          live.settle = setTimeout(finaliseBot, TURN_SETTLE_MS);
        },
        onServerMessage: (data: any) => {
          if (!data || data.type !== 'show_action_form') return;
          lead.name = data.name || '';
          lead.email = data.email || '';
          showActionForm(data.intent || 'send_info', data.topic || '', data.preferredTime || '', data.preferredDate || '');
        },
        onDisconnected: () => {
          if (live.client) stopLive('Voice session ended. Press Voice to reconnect, or just type.');
        },
      },
    });
    live.client = client;
    /* webrtcRequestParams, NOT {endpoint}: the bare-endpoint form is the deprecated
       "start bot" flow and 400s against this server. */
    await client.connect({
      webrtcRequestParams: { endpoint: d.connectUrl, requestData: { website: d.website } },
    });
    vlog('connected');
    refreshVoiceUi();
    if (live.connBub) { live.connBub.textContent = 'You are through to Vera.'; live.connBub = null; }
    live.timer = setTimeout(() => stopLive('Voice session ended (five minute cap). Tap the mic to carry on.'), 300000);
  }

  function voiceFlow() {
    if (live.client) { stopLive(); return; }
    if (!LIVE.voice || !window.isSecureContext) return;
    startLive().catch((err) => {
      console.warn('voice failed', err);
      vlog('fail', { name: err && err.name, msg: String((err && err.message) || err).slice(0, 200) });
      stopLive();
      if (err && err.name === 'NotAllowedError') {
        agentSay('I could not get microphone access. Allow the microphone for this page and press Voice again, or just type.');
        return;
      }
      agentSay('Vera’s voice line dropped while connecting. Press Voice to try again, or just type.');
    });
  }
  mic.addEventListener('click', voiceFlow);
  voiceBtn.addEventListener('click', voiceFlow);
</script>
