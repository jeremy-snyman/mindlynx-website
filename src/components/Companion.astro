---
// Vera, the MindLynx front of house. Floating launcher + chat panel, ported
// from the Helix site's inline companion (helix-website/public/index.html).
// The launcher stays hidden until GET /api/agent confirms a live brain.
---

<aside class="companion" id="companion">
  <button
    class="cmp-launcher"
    id="cmp-launcher"
    type="button"
    data-track="companion-open"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-label="Ask Vera, the MindLynx companion"
    hidden
  >
    <span class="cmp-launcher-dot" aria-hidden="true"></span>
    <span class="cmp-launcher-word">Ask</span>
  </button>

  <section class="cmp-panel" id="cmp-panel" role="dialog" aria-modal="false" aria-label="Conversation with Vera" hidden>
    <header class="cmp-bar">
      <span class="cmp-id"><i aria-hidden="true"></i>Vera · MindLynx front of house</span>
      <div class="cmp-bar-tools">
        <button class="cmp-voice" id="cmp-voice" type="button" hidden>Voice: start</button>
        <button class="cmp-close" id="cmp-close" type="button" aria-label="Close the conversation">×</button>
      </div>
    </header>
    <div class="cmp-chat" id="cmp-chat" aria-live="polite" aria-label="Messages"></div>
    <div class="cmp-chips" id="cmp-chips">
      <button class="cmp-chip" type="button">What do you actually do?</button>
      <button class="cmp-chip" type="button">What is Helix?</button>
      <button class="cmp-chip" type="button">What is Albion?</button>
      <button class="cmp-chip" type="button">How does the consulting work?</button>
      <button class="cmp-chip" type="button">Set up a scoping call</button>
    </div>
    <div class="cmp-input">
      <button class="cmp-mic" id="cmp-mic" type="button" title="Speak to Vera" aria-label="Speak to Vera" hidden>●</button>
      <input id="cmp-q" type="text" placeholder="Ask about MindLynx…" autocomplete="off" />
      <button class="cmp-send" id="cmp-send" type="button">Send</button>
    </div>
    <p class="cmp-note">Replies are generated by Google Gemini. Nothing is stored. <a href="/privacy">Privacy</a></p>
  </section>
</aside>

<style is:global>
  /* All companion styles are global (chat bubbles and forms are created by
     script, so Astro's scoped selectors would never match them) and live
     under the .companion / .cmp- namespace. */
  .companion { --cmp-surface: rgba(7, 17, 15, 0.96); }

  .cmp-launcher {
    position: fixed;
    z-index: 50;
    right: 24px;
    bottom: 24px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: var(--cmp-surface);
    backdrop-filter: blur(14px);
    border: 1px solid var(--warm);
    color: var(--cream);
    cursor: pointer;
    font-family: var(--sans);
    transition: transform 200ms ease, background 200ms ease, bottom 200ms ease;
  }
  .cmp-launcher:hover { transform: translateY(-2px); background: var(--ink-soft); }
  .cmp-launcher[hidden] { display: none; }
  .cmp-launcher-word {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .cmp-launcher-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--warm); }
  .companion.open .cmp-launcher { display: none; }

  .cmp-panel {
    position: fixed;
    z-index: 55;
    right: 24px;
    bottom: 24px;
    width: min(420px, calc(100vw - 32px));
    height: min(680px, 85dvh);
    display: flex;
    flex-direction: column;
    background: var(--cmp-surface);
    backdrop-filter: blur(18px);
    border: 1px solid rgba(247, 241, 229, 0.16);
    color: var(--cream);
  }
  .cmp-panel[hidden] { display: none; }

  .cmp-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--line-light);
  }
  .cmp-id {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(247, 241, 229, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .cmp-id i { width: 8px; height: 8px; border-radius: 50%; background: var(--warm); flex: none; }
  .cmp-bar-tools { flex: none; }
  .cmp-bar-tools { display: flex; align-items: center; gap: 6px; }
  .cmp-voice {
    white-space: nowrap;
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--line-light);
    color: rgba(247, 241, 229, 0.75);
    padding: 7px 10px;
    cursor: pointer;
  }
  .cmp-voice:hover { border-color: var(--warm); color: var(--cream); }
  .cmp-close {
    background: none;
    border: 0;
    color: rgba(247, 241, 229, 0.75);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 6px 10px;
    margin: -6px -10px -6px 0;
  }
  .cmp-close:hover { color: var(--cream); }

  .cmp-chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--line-light) transparent;
  }
  .cmp-msg {
    max-width: 86%;
    padding: 11px 14px;
    font-size: 0.93rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }
  .cmp-msg.agent {
    background: rgba(247, 241, 229, 0.05);
    border: 1px solid var(--line-light);
    align-self: flex-start;
  }
  .cmp-msg.agent b { color: var(--warm); font-weight: 600; }
  .cmp-msg.agent a { color: var(--cream); text-decoration-color: var(--warm); text-underline-offset: 3px; }
  .cmp-msg.user { background: var(--warm); color: #10150f; align-self: flex-end; }

  .cmp-typing i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(247, 241, 229, 0.6);
    margin-right: 4px;
    animation: cmp-blink 1s infinite;
  }
  .cmp-typing i:nth-child(2) { animation-delay: 0.2s; }
  .cmp-typing i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes cmp-blink { 0%, 60%, 100% { opacity: 0.25; } 30% { opacity: 1; } }

  .cmp-chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 18px 14px; }
  .cmp-chip {
    font-family: var(--sans);
    font-size: 0.78rem;
    border: 1px solid var(--line-light);
    color: rgba(247, 241, 229, 0.72);
    background: none;
    padding: 8px 12px;
    cursor: pointer;
  }
  .cmp-chip:hover { border-color: var(--warm); color: var(--cream); }

  .cmp-input { display: flex; border-top: 1px solid var(--line-light); }
  .cmp-mic {
    width: 52px;
    border: 0;
    border-right: 1px solid var(--line-light);
    background: none;
    color: rgba(247, 241, 229, 0.6);
    cursor: pointer;
    font-size: 1rem;
  }
  .cmp-mic:hover, .cmp-mic.live { color: var(--warm); }
  .cmp-mic.rec { color: #e26d5c; animation: cmp-recpulse 1.2s infinite; }
  @keyframes cmp-recpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  .cmp-input input {
    flex: 1;
    min-width: 0;
    background: none;
    border: 0;
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.95rem;
    padding: 15px 14px;
    outline: none;
  }
  .cmp-input input::placeholder { color: rgba(247, 241, 229, 0.45); }
  .cmp-send {
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--warm);
    color: #10150f;
    border: 0;
    padding: 0 22px;
    cursor: pointer;
    font-weight: 600;
  }

  .cmp-note {
    margin: 0;
    padding: 9px 18px 12px;
    font-size: 0.7rem;
    color: rgba(247, 241, 229, 0.5);
  }
  .cmp-note a { color: inherit; text-decoration-color: var(--warm); text-underline-offset: 2px; }

  /* In-chat action form, created by script inside an agent bubble. */
  .cmp-form { display: grid; gap: 9px; margin-top: 10px; min-width: 240px; }
  .cmp-form input[type='text'],
  .cmp-form input[type='email'] {
    width: 100%;
    background: rgba(9, 18, 15, 0.6);
    border: 1px solid var(--line-light);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 0.88rem;
    padding: 10px 12px;
    outline: none;
  }
  .cmp-form input:focus { border-color: var(--warm); }
  .cmp-form label.cmp-consent {
    display: flex;
    gap: 9px;
    align-items: flex-start;
    font-size: 0.8rem;
    color: rgba(247, 241, 229, 0.72);
    cursor: pointer;
  }
  .cmp-form label.cmp-consent input { accent-color: var(--warm); width: 15px; height: 15px; flex: none; margin-top: 2px; }
  .cmp-form label.cmp-consent a { color: var(--cream); }
  .cmp-form .cmp-go,
  .cmp-form .cmp-cal {
    font-family: var(--sans);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    background: var(--warm);
    color: #10150f;
    border: 0;
    padding: 11px 16px;
    cursor: pointer;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    display: block;
  }
  .cmp-form .cmp-cal { background: none; border: 1px solid var(--warm); color: var(--cream); }
  .cmp-form .cmp-go:disabled { opacity: 0.55; cursor: default; }

  @media (max-width: 640px) {
    .cmp-panel { inset: 0; width: 100%; height: 100dvh; border: 0; }
    .cmp-launcher { right: 16px; bottom: 16px; }
    .cmp-chip { padding: 12px 14px; }
    .cmp-close { padding: 10px 14px; margin: -10px -14px -10px 0; }
    .cmp-voice { padding: 11px 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmp-launcher { transition: none; }
    .cmp-typing i, .cmp-mic.rec { animation: none; }
  }
</style>

<script>
  // Ported from helix-website/public/index.html (Ask Helix + voice pipeline).
  // Live model output is untrusted and only ever rendered with textContent;
  // innerHTML is reserved for author-written strings.
  const root = document.getElementById('companion')!;
  const launcher = document.getElementById('cmp-launcher') as HTMLButtonElement;
  const panel = document.getElementById('cmp-panel')!;
  const chat = document.getElementById('cmp-chat')!;
  const input = document.getElementById('cmp-q') as HTMLInputElement;
  const mic = document.getElementById('cmp-mic') as HTMLButtonElement;
  const voiceBtn = document.getElementById('cmp-voice') as HTMLButtonElement;

  const AGENT_ENDPOINT = '/api/agent';
  const FORM_ENDPOINT = '/api/contact';
  const LIVE = { agent: false, voice: false, calendly: '' };
  const history: { role: 'user' | 'agent'; content: string }[] = [];
  const lead = { name: '', email: '' };
  let opened = false;

  fetch(AGENT_ENDPOINT)
    .then((r) => r.json())
    .then((d) => {
      LIVE.agent = !!d.agent;
      LIVE.voice = !!d.voice;
      LIVE.calendly = typeof d.calendly === 'string' ? d.calendly : '';
      if (LIVE.agent) launcher.hidden = false;
      if (LIVE.voice) {
        mic.hidden = false;
        mic.classList.add('live');
        voiceBtn.hidden = false;
      }
    })
    .catch(() => {});

  /* ---- keep the launcher clear of the cookie notice ---- */
  const cookieNotice = document.querySelector<HTMLElement>('.cookie-notice');
  function dodgeCookieNotice() {
    if (cookieNotice && !cookieNotice.hidden && window.innerWidth < 880) {
      launcher.style.bottom = `${cookieNotice.offsetHeight + 36}px`;
    } else {
      launcher.style.bottom = '';
    }
  }
  if (cookieNotice) {
    new MutationObserver(dodgeCookieNotice).observe(cookieNotice, { attributes: true, attributeFilter: ['hidden'] });
    window.addEventListener('resize', dodgeCookieNotice, { passive: true });
    dodgeCookieNotice();
  }

  /* ---- open / close ---- */
  const smallScreen = () => window.matchMedia('(max-width: 640px)').matches;
  function openPanel() {
    root.classList.add('open');
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    if (smallScreen()) document.body.style.overflow = 'hidden';
    input.focus();
    if (!opened) {
      opened = true;
      agentSay(
        "Hello, I'm <b>Vera</b>. I can tell you about what we build here, and whether it's likely to be any use to you. What brought you along?"
      );
    }
  }
  function closePanel() {
    stopLive();
    root.classList.remove('open');
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    launcher.focus();
  }
  launcher.addEventListener('click', openPanel);
  document.getElementById('cmp-close')!.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closePanel();
  });

  /* ---- chat rendering ---- */
  function el(html: string, cls: string) {
    const d = document.createElement('div');
    d.className = 'cmp-msg ' + cls;
    d.innerHTML = html; // author-written strings only
    chat.appendChild(d);
    chat.scrollTop = chat.scrollHeight;
    return d;
  }
  function esc(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }
  function agentSay(html: string) {
    const t = el('<span class="cmp-typing"><i></i><i></i><i></i></span>', 'agent');
    setTimeout(() => {
      t.innerHTML = html;
      chat.scrollTop = chat.scrollHeight;
    }, 450 + Math.random() * 350);
  }

  const OUTAGE_LINE =
    'I am having trouble reaching my brain just now. Give it another go in a moment, or use the contact form on this page, or email <a href="mailto:hello@mindlynx.ai">hello@mindlynx.ai</a>.';

  function ask(q: string) {
    if (!q.trim() || !LIVE.agent) return;
    el(esc(q), 'user');
    history.push({ role: 'user', content: q });
    const t = el('<span class="cmp-typing"><i></i><i></i><i></i></span>', 'agent');
    fetch(AGENT_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: q, history }),
    })
      .then((r) => {
        if (!r.ok) throw 0;
        return r.json();
      })
      .then((d) => {
        if (!d.reply) throw 0;
        t.textContent = d.reply; // live model output: never innerHTML
        chat.scrollTop = chat.scrollHeight;
        history.push({ role: 'agent', content: d.reply });
        if (d.action && d.action.type === 'show_action_form') {
          lead.name = d.action.name || '';
          lead.email = d.action.email || '';
          setTimeout(() => showActionForm(d.action.intent, d.action.topic || ''), 600);
        }
      })
      .catch(() => {
        t.innerHTML = OUTAGE_LINE;
        chat.scrollTop = chat.scrollHeight;
      });
    input.value = '';
  }

  document.getElementById('cmp-send')!.addEventListener('click', () => ask(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') ask(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>('#cmp-chips .cmp-chip').forEach((c) => {
    c.addEventListener('click', () => ask(c.textContent || ''));
  });

  /* ---- the action form: render-only, the human presses submit ---- */
  type IntentCopy = {
    title: string;
    go: string;
    interest: string;
    consent: boolean;
    consentLabel?: string;
    topicHint?: string;
    calendly?: boolean;
    messageLead: string;
    thanks: string;
  };
  const INTENT_COPY: Record<string, IntentCopy> = {
    helix_waitlist: {
      title: 'Your Helix waiting-list sign-up', go: 'Put me on the list', interest: 'helix', consent: true,
      messageLead: 'Helix waiting list, via Vera.', thanks: 'You will hear from us the moment there is news.',
    },
    albion_waitlist: {
      title: 'Your Albion waitlist sign-up', go: 'Put me on the list', interest: 'albion', consent: true,
      topicHint: 'Your sector (it shapes what gets built first)',
      messageLead: 'Albion waitlist, via Vera.', thanks: 'You will hear from us the moment there is news.',
    },
    albion_contributor: {
      title: 'Your contributor register entry', go: 'Add me to the register', interest: 'contributor', consent: true,
      consentLabel: 'Contact me when my sector opens, with the terms in plain English. I can unsubscribe at any time',
      topicHint: 'Your sector and expertise',
      messageLead: 'Albion contributor register, via Vera.', thanks: 'When your sector opens, the terms come to you in plain English.',
    },
    scoping_call: {
      title: 'Your scoping call', go: 'Request the call', interest: 'call', consent: false, calendly: true,
      topicHint: 'What should we look at?',
      messageLead: 'Scoping call request, via Vera.', thanks: 'The team will reply by email with times for the call.',
    },
    design_partner: {
      title: 'Your design partner conversation', go: 'Start the conversation', interest: 'partner', consent: false,
      topicHint: 'What would you like to shape?',
      messageLead: 'Design partner conversation, via Vera.', thanks: 'The team will come back to you to set up the conversation.',
    },
    send_info: {
      title: 'Your details for the team', go: 'Send it to the team', interest: 'general', consent: false,
      topicHint: 'What is it about?',
      messageLead: 'Follow-up request, via Vera.', thanks: 'Someone will come back to you properly.',
    },
  };

  let lastForm: HTMLElement | null = null;
  function showActionForm(intent: string, topic: string) {
    const copy = INTENT_COPY[intent] || INTENT_COPY.send_info;
    /* never pre-fill fabricated values: a placeholder-looking email renders blank */
    if (/example|placeholder|test@|@test\.|your.?email|@email\./i.test(lead.email)) lead.email = '';
    if (lastForm) {
      const oldGo = lastForm.querySelector<HTMLButtonElement>('.cmp-go');
      if (oldGo && !oldGo.disabled) {
        oldGo.disabled = true;
        oldGo.textContent = 'Replaced below';
      }
    }
    const calendly = copy.calendly && LIVE.calendly;
    let html = '<b>' + copy.title + '</b><div class="cmp-form">';
    html += '<input type="text" class="cmp-f-name" value="' + esc(lead.name) + '" placeholder="Name">';
    html += '<input type="email" class="cmp-f-email" value="' + esc(lead.email) + '" placeholder="Email">';
    if (copy.topicHint) {
      html += '<input type="text" class="cmp-f-topic" value="' + esc(topic) + '" placeholder="' + esc(copy.topicHint) + '">';
    }
    if (copy.consent) {
      const label = copy.consentLabel || 'Email me news and launch updates for this list. I can unsubscribe at any time';
      html += '<label class="cmp-consent"><input type="checkbox" class="cmp-f-consent"> <span>' + label + ' (<a href="/privacy">privacy</a>).</span></label>';
    }
    if (calendly) {
      html += '<a class="cmp-cal" href="' + esc(LIVE.calendly) + '" target="_blank" rel="noopener noreferrer">Pick a time on the calendar</a>';
    }
    html += '<button class="cmp-go" type="button">' + copy.go + '</button></div>';
    const bubble = el(html, 'agent');
    lastForm = bubble;
    bubble.querySelector<HTMLButtonElement>('.cmp-go')!.addEventListener('click', () => {
      const n = bubble.querySelector<HTMLInputElement>('.cmp-f-name')!.value.trim();
      const e = bubble.querySelector<HTMLInputElement>('.cmp-f-email')!.value.trim();
      const consentBox = bubble.querySelector<HTMLInputElement>('.cmp-f-consent');
      const topicField = bubble.querySelector<HTMLInputElement>('.cmp-f-topic');
      if (!n || !/.+@.+\..+/.test(e)) {
        agentSay('I still need a name and a real email on that form.');
        return;
      }
      if (copy.consent && !(consentBox && consentBox.checked)) {
        agentSay("It's an email list, so I need the consent box ticked before I can add you. The privacy notice is linked right there on the form.");
        return;
      }
      const topicText = topicField ? topicField.value.trim() : '';
      const message = copy.messageLead + (topicText ? ' About: ' + topicText : '');
      const consented = !!(consentBox && consentBox.checked);
      fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: n,
          email: e,
          interest: copy.interest,
          message,
          consent: consented ? 'yes' : '',
          consentedAt: consented ? new Date().toISOString() : '',
          pageUrl: location.href,
          source: 'mindlynx.ai/companion',
          company: '',
        }),
      })
        .then((r) => {
          if (!r.ok) throw 0;
          const go = bubble.querySelector<HTMLButtonElement>('.cmp-go')!;
          go.disabled = true;
          go.textContent = 'Done';
          (window as any).Tachyon?.emit('LeadCaptured', {
            formType: 'companion',
            interest: copy.interest,
            marketingOptIn: consented,
          });
          agentSay('<b>' + esc(n.split(' ')[0]) + ", that's with the team.</b> " + copy.thanks);
        })
        .catch(() => {
          agentSay('That did not save. Give the button one more press, or use the contact form further down the page.');
        });
    });
  }

  /* ---- voice: Gemini Live, ported guards intact ---- */
  const GENAI_CDN = 'https://cdn.jsdelivr.net/npm/@google/genai@2.11.0/+esm'; /* pinned; keep in step with package.json */
  const WORKLET_SRC =
    "class P extends AudioWorkletProcessor{process(inputs){var ch=inputs[0][0];if(ch)this.port.postMessage(ch.slice(0));return true;}}registerProcessor('pcm-forwarder',P);";
  const live: any = { session: null, ctxIn: null, ctxOut: null, stream: null, sources: [], cursor: 0, timer: null, userBub: null, agentBub: null };
  const vlog = (stage: string, detail?: unknown) => console.log('[voice]', stage, detail || '');

  function b64FromBuf(buf: ArrayBuffer) {
    const b = new Uint8Array(buf);
    let s = '';
    for (let i = 0; i < b.length; i++) s += String.fromCharCode(b[i]);
    return btoa(s);
  }
  function playPcm(b64: string) {
    if (!live.ctxOut) return;
    if (!live.audioLogged) {
      live.audioLogged = true;
      vlog('first-audio', { ctxOut: live.ctxOut.state, bytes: b64.length });
    }
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const i16 = new Int16Array(bytes.buffer);
    const f32 = new Float32Array(i16.length);
    for (let j = 0; j < i16.length; j++) f32[j] = i16[j] / 32768;
    const ab = live.ctxOut.createBuffer(1, f32.length, 24000);
    ab.getChannelData(0).set(f32);
    const s = live.ctxOut.createBufferSource();
    s.buffer = ab;
    s.connect(live.dest || live.ctxOut.destination);
    live.cursor = Math.max(live.ctxOut.currentTime, live.cursor);
    s.start(live.cursor);
    live.cursor += ab.duration;
    live.sources.push(s);
    s.onended = () => {
      const k = live.sources.indexOf(s);
      if (k > -1) live.sources.splice(k, 1);
    };
  }
  function stopPlayback() {
    live.sources.forEach((s: AudioBufferSourceNode) => {
      try { s.stop(); } catch {}
    });
    live.sources = [];
    live.cursor = 0;
  }
  function transcript(role: 'user' | 'agent', text: string) {
    const key = role === 'user' ? 'userBub' : 'agentBub';
    if (!live[key]) live[key] = el('', role);
    live[key].textContent += text;
    chat.scrollTop = chat.scrollHeight;
  }
  function finaliseTranscripts() {
    if (live.userBub && live.userBub.textContent) history.push({ role: 'user', content: live.userBub.textContent });
    if (live.agentBub && live.agentBub.textContent) history.push({ role: 'agent', content: live.agentBub.textContent });
    live.userBub = live.agentBub = null;
  }
  function onLiveMessage(msg: any) {
    if (msg.data) playPcm(msg.data);
    const sc = msg.serverContent;
    if (sc) {
      if (sc.interrupted) { vlog('interrupted'); stopPlayback(); }
      if (sc.inputTranscription && sc.inputTranscription.text) transcript('user', sc.inputTranscription.text);
      if (sc.outputTranscription && sc.outputTranscription.text) transcript('agent', sc.outputTranscription.text);
      if (sc.turnComplete) finaliseTranscripts();
    }
    if (msg.toolCall && msg.toolCall.functionCalls) {
      msg.toolCall.functionCalls.forEach((fc: any) => {
        if (fc.name !== 'show_action_form') return;
        const a = fc.args || {};
        lead.name = a.name || '';
        lead.email = a.email || '';
        showActionForm(a.intent || 'send_info', a.topic || '');
        try {
          live.session.sendToolResponse({ functionResponses: [{ id: fc.id, name: fc.name, response: { result: 'form_shown_awaiting_human_click' } }] });
        } catch {}
      });
    }
    if (msg.goAway) stopLive('Voice session ending. Tap the mic to reconnect.');
  }
  function stopLive(notice?: string) {
    if (live.timer) { clearTimeout(live.timer); live.timer = null; }
    if (live.connBub) { live.connBub.textContent = 'Voice did not connect this time.'; live.connBub = null; }
    stopPlayback();
    finaliseTranscripts();
    if (live.session) { const s = live.session; live.session = null; try { s.close(); } catch {} }
    if (live.stream) { live.stream.getTracks().forEach((t: MediaStreamTrack) => t.stop()); live.stream = null; }
    if (live.audioEl) { try { live.audioEl.pause(); } catch {} live.audioEl = null; live.dest = null; }
    if (live.ctxIn) { live.ctxIn.close().catch(() => {}); live.ctxIn = null; }
    if (live.ctxOut) { live.ctxOut.close().catch(() => {}); live.ctxOut = null; }
    mic.classList.remove('rec');
    refreshVoiceUi();
    if (notice) agentSay(notice);
  }
  function refreshVoiceUi() {
    voiceBtn.textContent = live.session ? 'Voice: live · stop' : 'Voice: start';
  }
  async function acquireMic() {
    const base = { channelCount: 1, echoCancellation: true, noiseSuppression: true };
    const stream = await navigator.mediaDevices.getUserMedia({ audio: base });
    const isMobile = ((navigator as any).userAgentData && (navigator as any).userAgentData.mobile) || /iPhone|iPad|Android|Mobi/i.test(navigator.userAgent);
    if (isMobile) return stream; /* on a phone the phone mic is the right mic */
    const label = (stream.getAudioTracks()[0] || ({} as MediaStreamTrack)).label || '';
    if (/headphone|headset|airpod|earbud/i.test(label)) return stream; /* a worn mic is the best mic */
    if (!/phone|ipad|continuity/i.test(label)) return stream; /* "phone" catches renamed iPhones too */
    /* macOS Continuity has hijacked the default input with a nearby phone: use the built-in mic instead */
    const devs = await navigator.mediaDevices.enumerateDevices();
    const ins = devs.filter((d) => d.kind === 'audioinput' && d.deviceId && d.deviceId !== 'default');
    const builtin =
      ins.find((d) => /built-?in|macbook|internal/i.test(d.label)) ||
      ins.find((d) => !/phone|ipad|continuity/i.test(d.label));
    if (!builtin) return stream;
    vlog('mic-switch', { from: label, to: builtin.label });
    stream.getTracks().forEach((t) => t.stop());
    return navigator.mediaDevices.getUserMedia({ audio: Object.assign({ deviceId: { exact: builtin.deviceId } }, base) });
  }
  async function startLive() {
    mic.classList.add('rec');
    voiceBtn.textContent = 'Voice: connecting…';
    /* create the output context synchronously inside the click: created after the awaits,
       Chrome may treat the gesture as expired and start it suspended = silent Vera */
    live.ctxOut = new AudioContext({ sampleRate: 24000 });
    /* play through an <audio> element: Chrome's echo canceller ignores raw Web Audio output,
       so Vera's voice loops back into the mic and interrupts herself mid-sentence */
    live.dest = live.ctxOut.createMediaStreamDestination();
    live.audioEl = document.createElement('audio');
    live.audioEl.srcObject = live.dest.stream;
    live.audioEl.play().catch(() => {});
    live.audioLogged = false;
    live.connBub = el('<span class="cmp-typing"><i></i><i></i><i></i></span>&nbsp; Connecting you to Vera&hellip;', 'agent');
    vlog('start', { secure: window.isSecureContext, ctxOut: live.ctxOut.state });
    /* mic permission first: a denial must not burn a rate-limited token mint */
    live.stream = await acquireMic();
    vlog('mic-ok', { device: (live.stream.getAudioTracks()[0] || {}).label || 'unknown' });
    const r = await fetch('/api/voice-token', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    if (!r.ok) { vlog('mint-fail', { status: r.status }); throw new Error('mint ' + r.status); }
    const d = await r.json();
    vlog('mint-ok', { model: d.model });
    const mod = await import(/* @vite-ignore */ GENAI_CDN);
    vlog('cdn-ok');
    if (live.ctxOut.state === 'suspended') { vlog('ctx-suspended-resuming'); live.ctxOut.resume().catch(() => {}); }
    const ai = new mod.GoogleGenAI({ apiKey: d.token, httpOptions: { apiVersion: 'v1alpha' } });
    live.session = await ai.live.connect({
      model: d.model,
      config: { responseModalities: ['AUDIO'] }, /* everything else is locked in the token */
      callbacks: {
        onmessage: onLiveMessage,
        onerror: (e: any) => {
          vlog('ws-error', { msg: String((e && e.message) || e).slice(0, 200) });
          stopLive('Voice hit a snag. Press Voice to try again, or just type.');
        },
        onclose: (e: any) => {
          const reason = String((e && e.reason) || '');
          vlog('ws-close', { code: e && e.code, reason: reason.slice(0, 120) });
          if (live.session)
            stopLive(/exhaust|quota/i.test(reason)
              ? 'Vera’s voice is over its usage limit for the moment. Give it a minute and press Voice again, or just type.'
              : undefined);
        },
      },
    });
    vlog('connected');
    live.ctxIn = new AudioContext({ sampleRate: 16000 });
    const srcNode = live.ctxIn.createMediaStreamSource(live.stream);
    await live.ctxIn.audioWorklet.addModule(URL.createObjectURL(new Blob([WORKLET_SRC], { type: 'text/javascript' })));
    const node = new AudioWorkletNode(live.ctxIn, 'pcm-forwarder');
    node.port.onmessage = (e: MessageEvent) => {
      if (!live.session) return;
      const f32 = e.data as Float32Array;
      const i16 = new Int16Array(f32.length);
      for (let i = 0; i < f32.length; i++) {
        const v = Math.max(-1, Math.min(1, f32[i]));
        i16[i] = v < 0 ? v * 0x8000 : v * 0x7fff;
      }
      try {
        live.session.sendRealtimeInput({ audio: { data: b64FromBuf(i16.buffer), mimeType: 'audio/pcm;rate=16000' } });
      } catch {}
    };
    srcNode.connect(node);
    refreshVoiceUi();
    if (live.connBub) { live.connBub.textContent = 'You are through to Vera.'; live.connBub = null; }
    /* nudge Vera to open the conversation herself: one short greeting, then wait */
    try {
      live.session.sendClientContent({
        turns: [{ role: 'user', parts: [{ text: '(The visitor has just connected by voice. Greet them per A4: one short sentence, say who you are and ask what brought them along, then wait.)' }] }],
        turnComplete: true,
      });
    } catch {}
    live.timer = setTimeout(() => stopLive('Voice session ended (five minute cap). Tap the mic to carry on.'), 300000);
  }
  function voiceFlow() {
    if (live.session) { stopLive(); return; }
    if (!LIVE.voice || !window.isSecureContext) return;
    startLive().catch((err) => {
      console.warn('Gemini Live failed', err);
      vlog('fail', { name: err && err.name, msg: String((err && err.message) || err).slice(0, 200) });
      stopLive();
      if (err && err.name === 'NotAllowedError') {
        agentSay('I could not get microphone access. Allow the microphone for this page and press Voice again, or just type.');
        return;
      }
      /* no downgrade to the browser voice: offer a retry instead */
      agentSay('Vera’s voice line dropped while connecting. Press Voice to try again, or just type.');
    });
  }
  mic.addEventListener('click', voiceFlow);
  voiceBtn.addEventListener('click', voiceFlow);
</script>
